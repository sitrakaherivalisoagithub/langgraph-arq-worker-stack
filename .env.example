# Nom commun du projet : préfixe des volumes Docker
COMPOSE_PROJECT_NAME=langgraph_arq_demo
APP_NAME=langgraph-arq-demo

# API
API_PORT=8000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PORT_HOST=6379
ARQ_QUEUE_NAME=arq:queue

# PostgreSQL 16
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT_HOST=5432
DATABASE_URL=postgresql://chatbot:local_dev_password@postgres:5432/chatbot

# ARQ
JOB_TIMEOUT_SECONDS=300
MAX_WORKER_JOBS=5
